# Patient iPhone app (Expo). Copy to .env.local (git-ignored), fill in, then restart `npx expo start --clear`.
# These values are safe to ship in the app. NEVER put the sb_secret_... key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste-your-publishable-key-here
# Flask backend base URL, no trailing slash. On a real iPhone use your computer's LAN IP
# (e.g. http://192.168.1.20:5000) or the Render URL — "127.0.0.1" means the phone itself.
EXPO_PUBLIC_API_BASE_URL=https://your-backend.onrender.com
