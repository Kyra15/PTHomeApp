# Copy to .env (git-ignored) and fill in. Load it with:  set -a; source .env; set +a
# Supabase → Project Settings → API. The secret key is server-side only — never put it in the app or portal.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_paste-your-secret-key-here
# Comma-separated origins allowed to call the API from a browser (the admin-web portal)
CORS_ORIGINS=http://localhost:5173
# Public URL of the admin-web portal (used in the link inside invite emails)
PORTAL_URL=http://localhost:5173
# Optional: email delivery via https://resend.com. Without it, invites are still created and the
# portal shows the code for the therapist to share by hand.
RESEND_API_KEY=
EMAIL_FROM="Kinetic <onboarding@resend.dev>"
