# Copy to .env.local (git-ignored). All three values are safe to ship in a browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste-your-publishable-key-here
# Your Flask backend's base URL (no trailing slash), used only by the sign-up form to create
# a therapist account. Local dev: http://127.0.0.1:5000  Render: https://<your-service>.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:5000
